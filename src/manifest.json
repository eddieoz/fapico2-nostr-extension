{
  "manifest_version": 3,
  "name": "fapico2 Nostr",
  "version": "0.2.0",
  "description": "Hardware-first Nostr signing: keys live on the fapico2 board, consent is a physical touch.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "hid"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "fapico2 Nostr"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "provider.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
